# Copy to server/.env and fill in. Never commit the real file.

PORT=3000
NODE_ENV=development

# Required. The server refuses to start without these.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=generate-with-openssl-rand-hex-32

# Google Sign-In (same client ID as the frontend)
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Routing (a public pk. token works for Directions)
MAPBOX_TOKEN=

# LLM for ATLAS chat and news summaries (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=

# Live traffic flow (developer.tomtom.com, free tier)
TOMTOM_API_KEY=

# Legacy LLM provider, removed once chat and news move to Gemini (P5/P6)
FEATHERLESS_API_KEY=

# Legacy Flask ML service, removed in P4.4
ML_SERVICE_URL=http://localhost:5001
