# Copy to .env (repo root) and fill in. One file for the server and the client. Never commit the real file.
# Vite exposes only VITE_* keys to the browser; everything else stays on the server.

# ---- Server ----
PORT=3001
NODE_ENV=development

# Required. The server refuses to start without these.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=generate-with-openssl-rand-hex-32

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Routing (a public pk. token works for Directions)
MAPBOX_TOKEN=

# LLM for ATLAS chat and news summaries (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=

# Live traffic flow (developer.tomtom.com, free tier)
TOMTOM_API_KEY=

# Legacy LLM provider, removed once chat and news move to Gemini (P5/P6)
FEATHERLESS_API_KEY=


# ---- Client (public: bundled into the browser) ----
# Public Mapbox token (pk.). Restrict it to your domains in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=
# Backend base URL, including the /api prefix. For the production build, override on the command line:
#   VITE_API_URL=https://orionmaps-api.onrender.com/api npm run build
VITE_API_URL=http://localhost:3001/api
