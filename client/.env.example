# Copy to client/.env.development (local) or client/.env.production (build). Never commit the real files.

# Public Mapbox token (pk.). Restrict it to your domains in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Google Sign-In client ID (public by design)
VITE_GOOGLE_CLIENT_ID=

# Backend base URL, including the /api prefix
VITE_API_URL=http://localhost:3000/api
